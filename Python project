from pathlib import Path

DATA_FILE = Path(__file__).with_name("tasks.txt")


def load_tasks():
    tasks = []
    if not DATA_FILE.exists():
        return tasks
    try:
        with DATA_FILE.open("r", encoding="utf-8") as file:
            for line in file:
                parts = line.rstrip("\n").split("|", 4)
                if len(parts) != 5:
                    continue
                try:
                    task_id = int(parts[0])
                except ValueError:
                    continue
                tasks.append({
                    "id": task_id,
                    "title": parts[1],
                    "description": parts[2],
                    "priority": parts[3],
                    "completed": parts[4] == "True"
                })
    except OSError:
        print("Warning: saved tasks could not be read.")
    return tasks


def save_tasks(tasks):
    try:
        with DATA_FILE.open("w", encoding="utf-8") as file:
            for task in tasks:
                fields = [
                    str(task["id"]),
                    task["title"].replace("|", "/"),
                    task["description"].replace("|", "/"),
                    task["priority"],
                    str(task["completed"])
                ]
                file.write("|".join(fields) + "\n")
    except OSError:
        print("Error: tasks could not be saved.")


def get_next_id(tasks):
    return max((task["id"] for task in tasks), default=0) + 1


def find_task(tasks, task_id):
    for task in tasks:
        if task["id"] == task_id:
            return task
    return None


def add_task(tasks):
    print("\n--- Add New Task ---")
    title = input("Enter task name: ").strip()
    if not title:
        print("Task name cannot be empty.")
        return
    description = input("Enter description (optional): ").strip()
    print("Priority: 1. High  2. Medium  3. Low")
    choice = input("Choose priority (1-3, default 2): ").strip()
    priorities = {"1": "High", "2": "Medium", "3": "Low"}
    task = {
        "id": get_next_id(tasks),
        "title": title,
        "description": description,
        "priority": priorities.get(choice, "Medium"),
        "completed": False
    }
    tasks.append(task)
    save_tasks(tasks)
    print(f"Task #{task['id']} added successfully!")


def display_tasks(tasks, selected_tasks=None):
    if selected_tasks is None:
        selected_tasks = tasks
    if not selected_tasks:
        print("\nNo tasks to display.")
        return
    print("\n" + "=" * 72)
    print(f"{'ID':<5}{'Task':<25}{'Priority':<12}{'Status':<14}")
    print("-" * 72)
    for task in selected_tasks:
        status = "Completed" if task["completed"] else "Pending"
        title = task["title"][:20] + "..." if len(task["title"]) > 23 else task["title"]
        print(f"{task['id']:<5}{title:<25}{task['priority']:<12}{status:<14}")
        if task["description"]:
            print(f"     Description: {task['description']}")
    print("=" * 72)


def view_tasks(tasks):
    print("\n--- All Tasks ---")
    display_tasks(tasks)


def mark_completed(tasks):
    print("\n--- Mark Task as Completed ---")
    display_tasks(tasks)
    if not tasks:
        return
    try:
        task_id = int(input("Enter the task ID to complete: "))
    except ValueError:
        print("Please enter a valid numeric ID.")
        return
    task = find_task(tasks, task_id)
    if task is None:
        print("Task ID not found.")
    elif task["completed"]:
        print("This task is already completed.")
    else:
        task["completed"] = True
        save_tasks(tasks)
        print(f"'{task['title']}' marked as completed.")


def edit_task(tasks):
    print("\n--- Edit Task ---")
    display_tasks(tasks)
    if not tasks:
        return
    try:
        task_id = int(input("Enter the task ID to edit: "))
    except ValueError:
        print("Please enter a valid numeric ID.")
        return
    task = find_task(tasks, task_id)
    if task is None:
        print("Task ID not found.")
        return
    print("Press Enter to keep the current value.")
    title = input(f"Task name [{task['title']}]: ").strip()
    description = input(f"Description [{task['description']}]: ").strip()
    print("Priority: 1. High  2. Medium  3. Low")
    priority_choice = input(f"New priority (current: {task['priority']}): ").strip()
    if title:
        task["title"] = title
    if description:
        task["description"] = description
    priorities = {"1": "High", "2": "Medium", "3": "Low"}
    if priority_choice in priorities:
        task["priority"] = priorities[priority_choice]
    save_tasks(tasks)
    print("Task updated successfully!")


def delete_task(tasks):
    print("\n--- Delete Task ---")
    display_tasks(tasks)
    if not tasks:
        return
    try:
        task_id = int(input("Enter the task ID to delete: "))
    except ValueError:
        print("Please enter a valid numeric ID.")
        return
    task = find_task(tasks, task_id)
    if task is None:
        print("Task ID not found.")
        return
    confirm = input(f"Delete '{task['title']}'? (y/n): ").strip().lower()
    if confirm == "y":
        tasks.remove(task)
        save_tasks(tasks)
        print("Task deleted successfully.")
    else:
        print("Deletion cancelled.")


def search_tasks(tasks):
    print("\n--- Search Tasks ---")
    keyword = input("Enter a word to search: ").strip().lower()
    if not keyword:
        print("Please enter a search word.")
        return
    results = [
        task for task in tasks
        if keyword in task["title"].lower()
        or keyword in task["description"].lower()
    ]
    if results:
        print(f"\nFound {len(results)} matching task(s):")
        display_tasks(tasks, results)
    else:
        print("No matching tasks found.")


def filter_tasks(tasks):
    print("\n1. Pending tasks\n2. Completed tasks")
    choice = input("Choose a filter: ").strip()
    if choice == "1":
        results = [task for task in tasks if not task["completed"]]
        print("\n--- Pending Tasks ---")
    elif choice == "2":
        results = [task for task in tasks if task["completed"]]
        print("\n--- Completed Tasks ---")
    else:
        print("Invalid choice.")
        return
    display_tasks(tasks, results)


def show_statistics(tasks):
    total = len(tasks)
    completed = sum(1 for task in tasks if task["completed"])
    pending = total - completed
    percentage = completed / total * 100 if total else 0
    print("\n--- Task Statistics ---")
    print(f"Total tasks     : {total}")
    print(f"Completed tasks : {completed}")
    print(f"Pending tasks   : {pending}")
    print(f"Completion rate : {percentage:.1f}%")


def show_menu():
    print("\n" + "=" * 42)
    print("           TO-DO LIST MANAGER")
    print("=" * 42)
    print("1. Add a new task")
    print("2. View all tasks")
    print("3. Mark task as completed")
    print("4. Edit a task")
    print("5. Delete a task")
    print("6. Search tasks")
    print("7. Filter tasks")
    print("8. View task statistics")
    print("9. Exit")
    print("=" * 42)


def main():
    tasks = load_tasks()
    print("Welcome to the To-Do List Manager!")
    print(f"{len(tasks)} saved task(s) loaded.")
    while True:
        show_menu()
        choice = input("Enter your choice (1-9): ").strip()
        if choice == "1":
            add_task(tasks)
        elif choice == "2":
            view_tasks(tasks)
        elif choice == "3":
            mark_completed(tasks)
        elif choice == "4":
            edit_task(tasks)
        elif choice == "5":
            delete_task(tasks)
        elif choice == "6":
            search_tasks(tasks)
        elif choice == "7":
            filter_tasks(tasks)
        elif choice == "8":
            show_statistics(tasks)
        elif choice == "9":
            save_tasks(tasks)
            print("Your tasks have been saved. Goodbye!")
            break
        else:
            print("Invalid choice. Please select a number from 1 to 9.")


if __name__ == "__main__":
    main()
